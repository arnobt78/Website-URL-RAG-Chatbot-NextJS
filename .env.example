# =============================================================================
# Website-URL-RAG-Chatbot — Environment Variables
# Copy this file to `.env` and fill in placeholder values. Never commit `.env`.
# =============================================================================

# --- Upstash Redis (chat history + indexed-url deduplication) ----------------
# https://console.upstash.com/redis → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash Vector (semantic embeddings / RAG context storage) ----------------
# https://console.upstash.com/vector → Details tab
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# --- Upstash Workflow / QStash (required for whole-site async crawl) ---------
# https://console.upstash.com/qstash → QStash → Signing Keys + API Keys
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional — omit to use SDK default (https://qstash.upstash.io).
# Use your regional URL from the Upstash console if triggers fail (e.g. EU):
# QSTASH_URL=https://qstash-eu-central-1.upstash.io
# Public URL where this app runs (Workflow calls back to /api/crawl/workflow)
APP_BASE_URL=http://localhost:3000
# Local only — auto-starts QStash dev server; do not set on Vercel
# QSTASH_DEV=true

# --- Whole-site crawl (Firecrawl default; optional Crawl4AI) ---------------
# https://www.firecrawl.dev/ → Dashboard → API Keys (~1,000 free credits/month)
FIRECRAWL_API_KEY=
CRAWL_MAX_PAGES=100
# firecrawl | crawl4ai | jina-single
CRAWL_PROVIDER=firecrawl
# Self-hosted Crawl4AI — see docs/SELF_HOST_CRAWL.md and docker/crawl4ai/
# CRAWL4AI_BASE_URL=http://localhost:11235
# CRAWL4AI_API_TOKEN=
# Dynamic crawl v2 — tab/accordion/dialog expand-harvest + optional Firecrawl interact fallback
CRAWL_INTERACT_ENABLED=true
CRAWL_MAX_ACTIONS_PER_PAGE=8
CRAWL_INTERACT_MAX_PAGES=8
CRAWL_EXPAND_HIDDEN=true

# --- Page reader (optional — single-page fallback when CRAWL_PROVIDER=jina-single)
# https://jina.ai/reader
JINA_API_KEY=

# --- Soft rate limits (optional — defaults match production caps) ------------
# RATE_LIMIT_CHAT_MAX=30
# RATE_LIMIT_INGEST_MAX_PER_IP=10
# RATE_LIMIT_INGEST_MAX_GLOBAL=100
# RATE_LIMIT_CRAWL_MAX_PER_HOUR=3
# RATE_LIMIT_CRAWL_STATUS_MAX=120

# --- LLM providers (at least ONE required for chat) --------------------------
# Fallback order: Gemini → Groq → OpenRouter → Hugging Face → OpenAI

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Optional OpenAI (paid): https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# --- Observability (optional — disabled when keys empty) ---------------------
# Sentry — same-origin tunnel at /api/monitoring (ad-blocker bypass)
# https://sentry.io → Project → Client Keys / Settings
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Server-only — source maps / CI upload (org + project + token required)
# SENTRY_AUTH_TOKEN=

# Langfuse — server-only chat tracing (no browser SDK)
# https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Optional CI smoke test --------------------------------------------------
# RUN_LIVE_INGEST_SMOKE=1 with npm run test:live-ingest

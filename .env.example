# =============================================================================
# Website-URL-RAG-Chatbot — Environment Variables
# Copy this file to `.env` and fill in placeholder values. Never commit `.env`.
# =============================================================================

# --- Upstash Redis (chat history + indexed-url deduplication) ----------------
# Console: https://console.upstash.com/redis → Create Database → REST API tab
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash Vector (semantic embeddings / RAG context storage) ---------------
# Console: https://console.upstash.com/vector → Create Index → Details tab
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# --- Upstash QStash (optional — legacy; hosted LLMs discontinued Oct 2025) ----
# Console: https://console.upstash.com/qstash → Signing Keys / API Keys
# QSTASH_TOKEN=

# --- LLM providers (at least ONE required for chat) -----------------------------
# Multi-provider fallback tries in order: Gemini → Groq → OpenRouter → HF → OpenAI

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GroqCloud: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (use :free model IDs): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face Inference: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Optional OpenAI (paid): https://platform.openai.com/api-keys
# OPENAI_API_KEY=

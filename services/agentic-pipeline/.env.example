# Copy to `.env` (do not commit secrets).
# Preferred: from repo root run ./scripts/gen-local-service-env.sh
# (writes a ≥32-char token; never commit the generated .env)

# Leave empty here — set a strong token locally or in Coolify (≥32 chars).
# Placeholders like "change-me" are rejected at startup (fail-closed).
AGENTIC_API_TOKEN=
PORT=8080
MAX_DEBATE_ROUNDS=3

# Local demos only — disables bearer auth. NEVER set on Coolify/public hosts.
# AGENTIC_ALLOW_INSECURE_DEV=true

# Optional extractors
# CRAWL4AI_BASE_URL=http://localhost:11235
# CRAWL4AI_API_TOKEN=
# FIRECRAWL_API_KEY=

# Free-tier LLM chain (first key wins per stage call)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
